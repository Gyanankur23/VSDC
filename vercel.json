{
  "version": 2,
  "buildCommand": "cd client && npm run build",
  "installCommand": "cd client && npm install",
  "outputDirectory": "client/build",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://vsdc-server.vercel.app/api/$1"
    },
    {
      "src": "/profile.html",
      "dest": "/profile.html"
    },
    {
      "src": "/event-details.html",
      "dest": "/event-details.html"
    },
    {
      "src": "/bootcamp.html",
      "dest": "/bootcamp.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(?:html|json)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}